# Copier en `.env.local` (non versionné) pour le développement.

# Adresse du Worker multi-appareils. Vide = même origine que l'application.
#   npm run party:dev   →  http://localhost:8787
VITE_PARTY_HOST=localhost:8787

# Force `ws` ou `wss`. Par défaut : ws en local, wss ailleurs.
VITE_PARTY_PROTOCOL=ws
